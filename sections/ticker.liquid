{%- if section.settings.enable -%}
  {%- unless section.settings.show_only_on_homepage and request.page_type != 'index' -%}
    {%- liquid
      assign ticker_gap = section.settings.gap
      assign ticker_gap_mobile = section.settings.gap_mobile
      assign ticker_bg = section.settings.background_color
      assign ticker_text = section.settings.text_color
    -%}

    {%- style -%}
      .ticker-{{ section.id }} {
        --ticker-gap: {{ ticker_gap_mobile }}px;
        --ticker-bg: {{ ticker_bg }};
        --ticker-text: {{ ticker_text }};
        width: 100%;
        overflow: hidden;
        background-color: var(--ticker-bg);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .ticker-{{ section.id }} .ticker__track {
        display: flex;
        align-items: center;
        gap: var(--ticker-gap);
        width: max-content;
        padding: {{ section.settings.padding_vertical }}px 0;
        white-space: nowrap;
        animation: tickerScroll-{{ section.id }} {{ section.settings.animation_speed }}s linear infinite;
      }
      {%- if section.settings.pause_on_hover -%}
        .ticker-{{ section.id }}:hover .ticker__track {
          animation-play-state: paused;
        }
      {%- endif -%}
      .ticker-{{ section.id }} .ticker__item {
        display: inline-flex;
        align-items: center;
        color: var(--ticker-text);
        font-size: 13.8px;
        line-height: 19.25px;
        letter-spacing: 0.4px;
        font-weight: 400;
      }
      .ticker-{{ section.id }} .ticker__item a {
        color: inherit;
        text-decoration: none;
      }
      .ticker-{{ section.id }} .ticker__bold {
        font-weight: 600;
      }
      @media (min-width: 768px) {
        .ticker-{{ section.id }} {
          --ticker-gap: {{ ticker_gap }}px;
        }
      }
      @keyframes tickerScroll-{{ section.id }} {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-50%);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .ticker-{{ section.id }} .ticker__track {
          animation: none;
        }
      }
    {%- endstyle -%}

    <div
      class="ticker-{{ section.id }} tw-w-full"
      role="region"
      aria-label="{{ 'sections.ticker.aria_label' | t }}"
    >
      <div class="ticker__track">
        {%- for copy in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.bold_text != blank -%}
              <div
                class="ticker__item"
                {% if copy == 2 %}aria-hidden="true"{% endif %}
                {{ block.shopify_attributes }}
              >
                {%- capture message_html -%}
                  {%- if block.settings.prefix != blank -%}
                    <span>{{ block.settings.prefix }}</span>
                  {%- endif -%}
                  <span class="ticker__bold">{{ block.settings.bold_text }}</span>
                  {%- if block.settings.suffix != blank -%}
                    <span>{{ block.settings.suffix }}</span>
                  {%- endif -%}
                {%- endcapture -%}

                {%- if block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    {% if block.settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
                  >
                    {{ message_html }}
                  </a>
                {%- else -%}
                  {{ message_html }}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Ticker",
  "tag": "section",
  "class": "section-ticker",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Mostrar ticker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_only_on_homepage",
      "label": "Solo en la página de inicio",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#68B5A3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Velocidad (segundos por ciclo)",
      "min": 5,
      "max": 60,
      "step": 5,
      "default": 25
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Separación entre mensajes — escritorio (px)",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Separación entre mensajes — móvil (px)",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Padding vertical (px)",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar al pasar el cursor",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        {
          "type": "text",
          "id": "prefix",
          "label": "Texto inicial",
          "default": "✨ ",
          "info": "Emoji o texto antes del texto principal."
        },
        {
          "type": "text",
          "id": "bold_text",
          "label": "Texto principal (negrita)",
          "default": "KIT EMPRENDEDOR DE REGALO EN TU PRIMERA COMPRA "
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Texto final",
          "default": "✨"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Abrir enlace en nueva pestaña",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ticker",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "prefix": "✨ ",
            "bold_text": "KIT EMPRENDEDOR DE REGALO EN TU PRIMERA COMPRA ",
            "suffix": "✨"
          }
        },
        {
          "type": "message",
          "settings": {
            "prefix": "🛍️ ",
            "bold_text": "VENTA EXCLUSIVA MAYORISTA ",
            "suffix": "— Compra mínima $49.990 🛍️"
          }
        }
      ]
    }
  ]
}
{% endschema %}
