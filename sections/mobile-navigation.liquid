{% comment %}
  Mobile navigation chrome/settings only.
  The drawer and menu items are rendered from header.liquid via
  snippets/mj-mobile-nav-drawer.liquid so they share the same
  Button / Tree menu blocks as desktop (Shopify cannot expose
  another section's blocks via sections['header']).
  Keep this section enabled if you want to edit logo/footer settings
  in the theme editor; the drawer itself always comes from Header.
{% endcomment %}
{% schema %}
{
  "name": "t:sections.mobile-navigation.name",
  "class": "section-mobile-navigation",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.mobile-navigation.settings.description.content"
    },
    {
      "type": "checkbox",
      "id": "sync_from_header",
      "default": true,
      "label": "Usar menú del header (desktop)",
      "info": "El menú mobile siempre se toma del Header. Edita Button / Tree menu ahí."
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.mobile-navigation.settings.menu.label",
      "info": "Solo se usa si 'Usar menú del header' está desactivado y no hay bloques Menu propios."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Si está vacío, usa el logo del Header."
    },
    {
      "type": "checkbox",
      "id": "show_stores_footer",
      "default": true,
      "label": "Show stores footer"
    },
    {
      "type": "text",
      "id": "stores_footer_text",
      "label": "Stores footer text",
      "default": "Tiendas — 37 en todo Chile"
    },
    {
      "type": "url",
      "id": "stores_footer_link",
      "label": "Stores footer link"
    },
    {
      "type": "checkbox",
      "id": "show_footer_links",
      "default": true,
      "label": "Show utility links in footer"
    },
    {
      "type": "text",
