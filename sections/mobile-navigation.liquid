      "label": "Footer link 1 text",
      "default": "Plata 925 certificada"
    },
    {
      "type": "url",
      "id": "footer_link_1_link",
      "label": "Footer link 1 URL"
    },
    {
      "type": "checkbox",
      "id": "footer_link_1_show_check",
      "default": true,
      "label": "Show check icon on footer link 1"
    },
    {
      "type": "text",
      "id": "footer_link_2_text",
      "label": "Footer link 2 text",
      "default": "Todo para emprender"
    },
    {
      "type": "url",
      "id": "footer_link_2_link",
      "label": "Footer link 2 URL"
    },
    {
      "type": "checkbox",
      "id": "show_footer_login",
