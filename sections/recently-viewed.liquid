{%- liquid
  assign products_to_show = section.settings.products_to_show | plus: 0
  assign columns_desktop = section.settings.columns_desktop | plus: 0
  assign columns_mobile = 2
  assign gap_desktop = section.settings.gap
  assign gap_mobile = section.settings.gap_mobile

  assign result_count = search.results_count
  if result_count == 0 and request.design_mode
    assign result_count = products_to_show
  endif

  assign enable_slider = false
  if result_count > columns_mobile
    assign enable_slider = true
  endif

  assign disable_quickview = true
  if section.settings.show_quickview
    assign disable_quickview = false
  endif

  assign current_product_id = product.id | default: ''
-%}

{%- style -%}
  .recently-viewed-{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 768px) {
    .recently-viewed-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .recently-viewed-{{ section.id }} .recently-viewed__heading {
    margin: 0 0 2rem;
    text-align: center;
    color: #0e1b1f;
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 400;
  }
  @media (min-width: 768px) {
    .recently-viewed-{{ section.id }} .recently-viewed__heading {
      font-size: 2.25rem;
      line-height: 2.625rem;
    }
  }
  .recently-viewed-{{ section.id }} .recently-viewed__track {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  @media (min-width: 768px) {
    .recently-viewed-{{ section.id }} .recently-viewed__track {
      padding-left: 0;
      padding-right: 0;
    }
  }
  .recently-viewed-{{ section.id }} .recently-viewed__carousel {
    position: relative;
  }
  @media (max-width: 767px) {
    .recently-viewed-{{ section.id }} .preload-slide-{{ section.id }} {
      {%- if settings.lang_direction contains request.locale.iso_code -%}
        margin-left: {{ gap_mobile }}px;
      {%- else -%}
        margin-right: {{ gap_mobile }}px;
      {%- endif -%}
      width: calc(((100% + {{ gap_mobile }}px) / {{ columns_mobile }}) - {{ gap_mobile }}px);
    }
  }
  @media (min-width: 768px) {
    .recently-viewed-{{ section.id }} .preload-slide-{{ section.id }} {
      {%- if settings.lang_direction contains request.locale.iso_code -%}
        margin-left: {{ gap_desktop }}px;
      {%- else -%}
        margin-right: {{ gap_desktop }}px;
      {%- endif -%}
      width: calc(((100% + {{ gap_desktop }}px) / {{ columns_desktop }}) - {{ gap_desktop }}px);
    }
  }
  .recently-viewed-{{ section.id }} .recently-viewed__arrows {
    display: none;
  }
  @media (min-width: 768px) {
    .recently-viewed-{{ section.id }} .recently-viewed__arrows {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 30;
    }
  }
  .recently-viewed-{{ section.id }} .recently-viewed__arrow {
    pointer-events: auto;
    position: absolute;
    top: 30%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    min-height: 44px;
    padding: 10px 2px;
    border: none;
    background: transparent;
    color: #222222;
    cursor: pointer;
    z-index: 21;
    transition: opacity 0.15s ease;
  }
  .recently-viewed-{{ section.id }} .recently-viewed__arrow:hover,
  .recently-viewed-{{ section.id }} .recently-viewed__arrow:focus-visible {
    opacity: 0.65;
  }
  .recently-viewed-{{ section.id }} .recently-viewed__arrow:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }
  .recently-viewed-{{ section.id }} .recently-viewed__arrow--prev {
    left: 0;
  }
  .recently-viewed-{{ section.id }} .recently-viewed__arrow--next {
    right: 0;
  }
  .recently-viewed-{{ section.id }} .recently-viewed__arrow-icon {
    display: flex;
    width: 24px;
    height: 24px;
  }
  .recently-viewed-{{ section.id }} .recently-viewed__arrow-icon svg {
    width: 24px;
    height: 24px;
  }
{%- endstyle -%}

<div
  id="shopify-section-recently-viewed"
  class="recently-viewed-{{ section.id }} recently-viewed-section"
  x-show="$store.xProductRecently.show"
  x-cloak
  x-products-to-show="{{ products_to_show }}"
  x-init='$store.xProductRecently.showProductRecently(); $store.xProductRecently.getProductRecently("{{ section.id }}", {% if current_product_id != blank %}"{{ current_product_id }}"{% else %}null{% endif %})'
  role="region"
  aria-label="{{ 'sections.recently-viewed-products.aria_label' | t }}"
>
  <div class="x-page-width page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="recently-viewed__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <div
      id="recently-viewed-carousel-{{ section.id }}"
      class="recently-viewed__carousel carousel-mobile carousel-tablet overflow-hidden x-splide splide visible disable-effect-hover disable-animation-slideshow{% unless enable_slider %} recently-viewed__carousel--static{% endunless %}"
      data-recently-viewed-carousel
      data-columns-desktop="{{ columns_desktop }}"
      data-columns-mobile="{{ columns_mobile }}"
      {% if enable_slider %}
        x-data-slider="{{ section.id }}"
        x-intersect.once.margin.200px='$store.xSplide.load($el, {
          "speed": 1000,
          "type": "slide",
          "mediaQuery": "min",
          "updateOnMove": "true",
          "gap": "{{ gap_mobile }}px",
          "perPage": {{ columns_mobile }},
          "perMove": {{ columns_mobile }},
          "autoWidth": false,
          "arrows": false,
          "pagination": false,
          "drag": true,
          "trimSpace": false,
          {%- if settings.lang_direction contains request.locale.iso_code -%}
            "direction": "rtl",
          {%- endif -%}
          "breakpoints": {
            300: {
              "gap": "{{ gap_mobile }}px",
              "perPage": {{ columns_mobile }},
              "perMove": {{ columns_mobile }}
            },
            768: {
              "destroy": false,
              "perPage": {{ columns_desktop }},
              "perMove": {{ columns_desktop }},
              "autoWidth": false,
              "gap": "{{ gap_desktop }}px",
              "drag": true
            },
            1024: {
              "perPage": {{ columns_desktop }},
              "perMove": {{ columns_desktop }},
              "gap": "{{ gap_desktop }}px"
            }
          },
          "classes": {
            "pagination": "hidden"
          },
          "events": [
            {
              "event": "mounted",
              "callback": function () {
                document.dispatchEvent(new CustomEvent("eurus:{{ section.id }}:splide-ready"));
                if (window.bindFeaturedCollectionMjArrows) {
                  window.bindFeaturedCollectionMjArrows(
                    document.getElementById("recently-viewed-carousel-{{ section.id }}"),
                    {{ columns_desktop }},
                    {{ columns_mobile }}
                  );
                }
              }
            }
          ]
        })'
      {% endif %}
    >
      <div class="splide__track recently-viewed__track overflow-hidden w-full{% if enable_slider %} md:cursor-grab{% endif %}">
        <div class="splide__list md:grid-cols-none md:flex md:w-full md:gap-0 flex w-full">
          {%- for item in search.results limit: products_to_show -%}
            {%- liquid
              assign rv_class_slide = 'splide__slide x-splide-slide preload-slide-' | append: section.id | append: ' h-auto'
            -%}
            {% render 'card-product',
              card_product: item,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              show_highlighted_attributes: section.settings.show_highlighted_attributes,
              section_id: section.id,
              class_slide: rv_class_slide,
              disable_image_slider: true,
              column_mobile: columns_mobile,
              columns_desktop: columns_desktop,
              index: forloop.index,
              list_name: section.settings.heading,
              block_id: section.id,
              product_card_id: forloop.index,
              disable_quickview: disable_quickview,
              disable_badges: true,
              render_static_badges: true,
              media_aspect_ratio: '100',
              swiper_on_mobile: enable_slider,
              enable_desktop_slider: enable_slider,
              animation_loading: false,
              loading: 'eager'
            %}
          {%- else -%}
            {%- if request.design_mode -%}
              {%- for i in (1..columns_desktop) -%}
                {%- liquid
                  assign rv_class_slide = 'splide__slide x-splide-slide preload-slide-' | append: section.id | append: ' h-auto'
                -%}
                <div class="card-product overflow-hidden card relative pb-4 tw-flex tw-flex-col {{ rv_class_slide }}">
                  <div class="tw-aspect-square tw-bg-[#f2f2f2]"></div>
                  <div class="tw-p-4 tw-text-sm tw-text-[#737373] tw-text-center">
                    {{ 'sections.recently-viewed-products.placeholder' | t }}
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if enable_slider -%}
        <div class="recently-viewed__arrows{% if settings.lang_direction contains request.locale.iso_code %} rtl{% endif %}">
          <button
            type="button"
            data-fc-mj-arrow="prev"
            class="recently-viewed__arrow recently-viewed__arrow--prev none_border"
            aria-label="{{ 'sections.recently-viewed-products.previous' | t }}"
            aria-disabled="true"
          >
            <span class="recently-viewed__arrow-icon rotate-90 rtl:-rotate-90" aria-hidden="true">
              {% render 'icon-alls', icon: 'icon-caret' %}
            </span>
          </button>
          <button
            type="button"
            data-fc-mj-arrow="next"
            class="recently-viewed__arrow recently-viewed__arrow--next none_border"
            aria-label="{{ 'sections.recently-viewed-products.next' | t }}"
            aria-disabled="false"
          >
            <span class="recently-viewed__arrow-icon -rotate-90 rtl:rotate-90" aria-hidden="true">
              {% render 'icon-alls', icon: 'icon-caret' %}
            </span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>

{%- if enable_slider -%}
  <script>
    (function () {
      var rootId = 'recently-viewed-carousel-{{ section.id }}';
      var desktopMove = {{ columns_desktop }};
      var mobileMove = {{ columns_mobile }};

      function tryBind() {
        if (typeof window.bindFeaturedCollectionMjArrows !== 'function') return false;
        var root = document.getElementById(rootId);
        if (!root || !root.splide) return false;
        window.bindFeaturedCollectionMjArrows(root, desktopMove, mobileMove);
        return true;
      }

      if (!tryBind()) {
        var attempts = 0;
        var timer = setInterval(function () {
          if (tryBind() || ++attempts > 150) clearInterval(timer);
        }, 100);
      }

      document.addEventListener('shopify:section:load', function () {
        setTimeout(tryBind, 250);
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.recently-viewed-products.name",
  "tag": "section",
  "class": "section-recently-viewed x-section",
  "limit": 1,
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.recently-viewed-products.settings.paragraph.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.text.heading",
      "default": "Tus últimos vistos"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 10,
      "label": "t:sections.main-product.blocks.complementary.settings.max_product_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.collection-list.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16,
      "label": "t:sections.all.spacing.label"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12,
      "label": "t:sections.all.spacing.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:settings_schema.search_navigation.settings.predictive_search_show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.featured-collection.blocks.collection.settings.show_rating.label"
    },
    {
      "type": "checkbox",
      "id": "show_highlighted_attributes",
      "default": true,
      "label": "t:sections.product-recommendations.settings.show_highlighted_attributes.label"
    },
    {
      "type": "checkbox",
      "id": "show_quickview",
      "default": false,
      "label": "t:sections.quick_view.show_quickview_button"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "t:sections.all.padding.padding_bottom"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_layout_mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.recently-viewed-products.name"
    }
  ]
}
{% endschema %}
