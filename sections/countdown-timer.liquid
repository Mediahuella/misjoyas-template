{%- if section.settings.enable -%}
  {%- unless section.settings.show_only_on_homepage and request.page_type != 'index' -%}
  {%- liquid
    assign countdown_title = section.settings.title
    assign countdown_subtitle = section.settings.subtitle
    assign box_bg = section.settings.box_background
    assign box_text = section.settings.box_text_color
    assign label_color = section.settings.label_color
    assign colon_color = section.settings.colon_color

    assign target_date = section.settings.target_date | default: '2026-12-31'
    assign target_time = section.settings.target_time | default: '23:59'
    assign date_parts = target_date | split: '-'
    assign time_parts = target_time | split: ':'
    assign end_year = date_parts[0] | plus: 0
    assign end_month = date_parts[1] | plus: 0
    assign end_day = date_parts[2] | plus: 0
    assign end_hour = time_parts[0] | plus: 0
    assign end_minute = time_parts[1] | default: '0' | plus: 0
    assign timezone = section.settings.timezone | default: '-4'

    assign hours_label = section.settings.hours_label | default: 'horas'
    assign minutes_label = section.settings.minutes_label | default: 'min'
    assign seconds_label = section.settings.seconds_label | default: 'seg'
  -%}

  {%- style -%}
    .countdown-timer-{{ section.id }} {
      --countdown-box-bg: {{ box_bg }};
      --countdown-box-text: {{ box_text }};
      --countdown-label-color: {{ label_color }};
      --countdown-colon-color: {{ colon_color }};
      width: 100%;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    @media (min-width: 768px) {
      .countdown-timer-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    .countdown-timer-{{ section.id }} .countdown-timer__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      padding: 1.25rem 1rem;
      max-width: 36.5625rem;
      margin: 0 auto;
    }
    @media (min-width: 768px) {
      .countdown-timer-{{ section.id }} .countdown-timer__inner {
        gap: 2.5rem;
        padding: 1.25rem 0;
        max-width: none;
      }
    }
    .countdown-timer-{{ section.id }} .countdown-timer__copy {
      display: flex;
      flex-direction: column;
      gap: 1.625rem;
      color: #000000;
      text-align: center;
    }
    @media (min-width: 768px) {
      .countdown-timer-{{ section.id }} .countdown-timer__copy {
        text-align: left;
        min-width: 13.8125rem;
      }
    }
    .countdown-timer-{{ section.id }} .countdown-timer__heading {
      margin: 0;
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 600;
      line-height: 2rem;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__subheading {
      margin: 0;
      font-size: clamp(1.125rem, 2.5vw, 1.625rem);
      font-weight: 400;
      line-height: 2rem;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__clock {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      align-items: center;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__timer {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 1rem;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      width: 5rem;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__box {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 5rem;
      height: 5.875rem;
      border-radius: 4px;
      background-color: var(--countdown-box-bg);
      color: var(--countdown-box-text);
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      font-weight: 400;
      line-height: 2rem;
      font-variant-numeric: tabular-nums;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__colon {
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: flex-start;
      height: 5.875rem;
      color: var(--countdown-colon-color);
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      line-height: 2rem;
      font-weight: 400;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__label {
      width: 100%;
      color: var(--countdown-label-color);
      font-size: clamp(1.125rem, 2.5vw, 1.625rem);
      line-height: 2rem;
      text-align: center;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__expired {
      margin: 0;
      text-align: center;
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--countdown-label-color);
    }
    .countdown-timer-{{ section.id }} .countdown-timer__cta {
      width: 100%;
      text-align: center;
      margin-top: 1rem;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__cta-link {
      display: inline-block;
      background-color: #000000;
      color: #ffffff;
      padding: 0.75rem 2rem;
      border-radius: 0.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: background-color 0.2s ease;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__cta-link:hover {
      background-color: #1f2937;
    }
  {%- endstyle -%}

  <div
    class="countdown-timer-{{ section.id }} tw-w-full"
    role="region"
    aria-label="{{ 'sections.countdown-timer.aria_label' | t }}"
    x-show="!(expired && {{ section.settings.hide_when_expired | json }})"
    x-cloak
    x-data="{
      loading: true,
      expired: false,
      hours: '00',
      minutes: '00',
      seconds: '00',
      pad(value) {
        return String(value).padStart(2, '0');
      }
    }"
    x-intersect.once.margin.200px="$store.xHelper.countdown({
      timezone: {{ timezone }},
      end_year: {{ end_year }},
      end_month: {{ end_month }},
      end_day: {{ end_day }},
      end_hour: {{ end_hour }},
      end_minute: {{ end_minute }}
    }, (canShow, s, m, h) => {
      if (!canShow) {
        expired = true;
      } else {
        hours = pad(h);
        minutes = pad(m);
        seconds = pad(s);
      }
      loading = false;
    })"
  >
    <div class="countdown-timer__inner x-page-width page-width">
      {%- if countdown_title != blank or countdown_subtitle != blank -%}
        <div class="countdown-timer__copy">
          {%- if countdown_title != blank -%}
            <h2 class="countdown-timer__heading">{{ countdown_title | escape }}</h2>
          {%- endif -%}
          {%- if countdown_subtitle != blank -%}
            <p class="countdown-timer__subheading">{{ countdown_subtitle | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="countdown-timer__clock">
        <p
          class="countdown-timer__expired"
          x-show="expired && !{{ section.settings.hide_when_expired | json }}"
          x-cloak
        >
          {{ section.settings.expired_message | escape }}
        </p>
        <div x-show="!expired" x-cloak>
          <div class="countdown-timer__timer" aria-live="polite">
            <div class="countdown-timer__unit">
              <div class="countdown-timer__box" aria-label="{{ hours_label | escape }}">
                <span x-text="loading ? '--' : hours"></span>
              </div>
              <span class="countdown-timer__label">{{ hours_label | escape }}</span>
            </div>
            <span class="countdown-timer__colon" aria-hidden="true">:</span>
            <div class="countdown-timer__unit">
              <div class="countdown-timer__box" aria-label="{{ minutes_label | escape }}">
                <span x-text="loading ? '--' : minutes"></span>
              </div>
              <span class="countdown-timer__label">{{ minutes_label | escape }}</span>
            </div>
            <span class="countdown-timer__colon" aria-hidden="true">:</span>
            <div class="countdown-timer__unit">
              <div class="countdown-timer__box" aria-label="{{ seconds_label | escape }}">
                <span x-text="loading ? '--' : seconds"></span>
              </div>
              <span class="countdown-timer__label">{{ seconds_label | escape }}</span>
            </div>
          </div>
        </div>
      </div>

      {%- if section.settings.cta_text != blank and section.settings.cta_url != blank -%}
        <div class="countdown-timer__cta">
          <a href="{{ section.settings.cta_url }}" class="countdown-timer__cta-link">
            {{ section.settings.cta_text | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Contador",
  "tag": "section",
  "class": "section-countdown-timer",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Mostrar contador",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_only_on_homepage",
      "label": "Solo en la página de inicio",
      "default": false
    },
    {
      "type": "header",
      "content": "Contador"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Cyber Day"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "¡Apúrate! quedan"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Fecha de término (AAAA-MM-DD)",
      "default": "2026-12-31",
      "info": "Formato: AAAA-MM-DD (ej. 2026-05-30)"
    },
    {
      "type": "text",
      "id": "target_time",
      "label": "Hora de término (formato 24h)",
      "default": "23:59",
      "info": "Formato: HH:MM (ej. 12:00 para mediodía)"
    },
    {
      "type": "select",
      "id": "timezone",
      "label": "Zona horaria",
      "default": "-4",
      "options": [
        { "value": "-4", "label": "UTC-4 (Chile continental)" },
        { "value": "-3", "label": "UTC-3" },
        { "value": "-5", "label": "UTC-5" },
        { "value": "0", "label": "UTC+0" }
      ]
    },
    {
      "type": "header",
      "content": "Etiquetas"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Etiqueta horas",
      "default": "horas"
    },
    {
      "type": "text",
      "id": "minutes_label",
      "label": "Etiqueta minutos",
      "default": "min"
    },
    {
      "type": "text",
      "id": "seconds_label",
      "label": "Etiqueta segundos",
      "default": "seg"
    },
    {
      "type": "header",
      "content": "Cuando termina el tiempo"
    },
    {
      "type": "checkbox",
      "id": "hide_when_expired",
      "label": "Ocultar sección al terminar",
      "default": true
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Mensaje si no se oculta",
      "default": "La promoción ha finalizado"
    },
    {
      "type": "header",
      "content": "Botón de acción"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "box_background",
      "label": "Fondo de los números",
      "default": "#f83785"
    },
    {
      "type": "color",
      "id": "box_text_color",
      "label": "Color de los números",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "colon_color",
      "label": "Color de los dos puntos",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color de las etiquetas",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior (desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior (desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior (mobile)",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Contador"
    }
  ]
}
{% endschema %}
