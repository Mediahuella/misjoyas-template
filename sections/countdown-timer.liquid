{%- if section.settings.enable -%}
  {%- unless section.settings.show_only_on_homepage and request.page_type != 'index' -%}
  {%- liquid
    assign countdown_heading = section.settings.heading
    assign countdown_subheading = section.settings.subheading
    assign box_bg = section.settings.box_background
    assign box_text = section.settings.box_text_color
    assign label_color = section.settings.label_color
    assign colon_color = section.settings.colon_color
  -%}

  {%- style -%}
    .countdown-timer-{{ section.id }} {
      --countdown-box-bg: {{ box_bg }};
      --countdown-box-text: {{ box_text }};
      --countdown-label-color: {{ label_color }};
      --countdown-colon-color: {{ colon_color }};
      width: 100%;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      padding: 1.25rem 1rem;
      max-width: 36.5625rem;
      margin: 0 auto;
    }
    @media (min-width: 768px) {
      .countdown-timer-{{ section.id }} .countdown-timer__inner {
        gap: 2.5rem;
        padding: 1.25rem 0;
        max-width: none;
      }
    }
    .countdown-timer-{{ section.id }} .countdown-timer__copy {
      display: flex;
      flex-direction: column;
      gap: 1.625rem;
      color: #000000;
      text-align: center;
    }
    @media (min-width: 768px) {
      .countdown-timer-{{ section.id }} .countdown-timer__copy {
        text-align: left;
        min-width: 13.8125rem;
      }
    }
    .countdown-timer-{{ section.id }} .countdown-timer__heading {
      margin: 0;
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 600;
      line-height: 2rem;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__subheading {
      margin: 0;
      font-size: clamp(1.125rem, 2.5vw, 1.625rem);
      font-weight: 400;
      line-height: 2rem;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__clock {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      align-items: center;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__digits {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__box {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 5rem;
      height: 5.875rem;
      border-radius: 4px;
      background-color: var(--countdown-box-bg);
      color: var(--countdown-box-text);
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      font-weight: 400;
      line-height: 2rem;
      font-variant-numeric: tabular-nums;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__colon {
      color: var(--countdown-colon-color);
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      line-height: 2rem;
      font-weight: 400;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__labels {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      width: 100%;
      max-width: 20.25rem;
      color: var(--countdown-label-color);
      font-size: clamp(1.125rem, 2.5vw, 1.625rem);
      line-height: 2rem;
      text-align: center;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__label {
      width: 5rem;
    }
    .countdown-timer-{{ section.id }} .countdown-timer__expired {
      margin: 0;
      text-align: center;
      font-size: 1.125rem;
      color: var(--countdown-label-color);
    }
  {%- endstyle -%}

  <div
    class="countdown-timer-{{ section.id }} tw-w-full"
    role="region"
    aria-label="{{ 'sections.countdown-timer.aria_label' | t }}"
    x-show="!(expired && {{ section.settings.hide_when_expired | json }})"
    x-cloak
    x-data="{
      loading: true,
      expired: false,
      hours: '00',
      minutes: '00',
      seconds: '00',
      pad(value) {
        return String(value).padStart(2, '0');
      }
    }"
    x-intersect.once.margin.200px="$store.xHelper.countdown({
      timezone: {{ section.settings.timezone | default: -4 }},
      end_year: {{ section.settings.end_year }},
      end_month: {{ section.settings.end_month }},
      end_day: {{ section.settings.end_day }},
      end_hour: {{ section.settings.end_hour }},
      end_minute: {{ section.settings.end_minute }}
    }, (canShow, s, m, h) => {
      if (!canShow) {
        expired = true;
      } else {
        hours = pad(h);
        minutes = pad(m);
        seconds = pad(s);
      }
      loading = false;
    })"
  >
    <div class="countdown-timer__inner x-page-width page-width">
      {%- if countdown_heading != blank or countdown_subheading != blank -%}
        <div class="countdown-timer__copy">
          {%- if countdown_heading != blank -%}
            <h2 class="countdown-timer__heading">{{ countdown_heading | escape }}</h2>
          {%- endif -%}
          {%- if countdown_subheading != blank -%}
            <p class="countdown-timer__subheading">{{ countdown_subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div
        class="countdown-timer__clock"
      >
        <p class="countdown-timer__expired" x-show="expired && !{{ section.settings.hide_when_expired | json }}" x-cloak>
          {{ section.settings.expired_message | escape }}
        </p>
        <div x-show="!expired" x-cloak>
          <div class="countdown-timer__digits" aria-live="polite">
              <div class="countdown-timer__box" aria-label="{{ 'sections.countdown-timer.hours' | t }}">
                <span x-text="loading ? '--' : hours"></span>
              </div>
              <span class="countdown-timer__colon" aria-hidden="true">:</span>
              <div class="countdown-timer__box" aria-label="{{ 'sections.countdown-timer.minutes' | t }}">
                <span x-text="loading ? '--' : minutes"></span>
              </div>
              <span class="countdown-timer__colon" aria-hidden="true">:</span>
              <div class="countdown-timer__box" aria-label="{{ 'sections.countdown-timer.seconds' | t }}">
                <span x-text="loading ? '--' : seconds"></span>
              </div>
            </div>
            <div class="countdown-timer__labels">
              <span class="countdown-timer__label">{{ 'sections.countdown-timer.hours' | t }}</span>
              <span class="countdown-timer__label">{{ 'sections.countdown-timer.minutes_short' | t }}</span>
              <span class="countdown-timer__label">{{ 'sections.countdown-timer.seconds_short' | t }}</span>
            </div>
          </div>
      </div>
    </div>
  </div>
  {%- endunless -%}
{%- endif -%}

