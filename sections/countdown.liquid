{%- liquid
  assign start_raw = section.settings.start_datetime | strip
  assign end_raw = section.settings.end_datetime | strip

  unless start_raw contains ' '
    if start_raw != blank
      assign start_raw = start_raw | append: ' 00:00:00'
    endif
  endunless
  unless end_raw contains ' '
    if end_raw != blank
      assign end_raw = end_raw | append: ' 23:59:59'
    endif
  endunless

  assign current_time = 'now' | date: '%Y-%m-%d %H:%M:%S'
  assign show_countdown = false

  if request.design_mode
    assign show_countdown = true
  elsif end_raw == blank
    assign show_countdown = false
  elsif start_raw == blank
    if current_time <= end_raw
      assign show_countdown = true
    endif
  else
    if current_time >= start_raw and current_time <= end_raw
      assign show_countdown = true
    endif
  endif
-%}

{% if show_countdown %}
<div
  class="countdown-section"
  style="
    --countdown-pad-top: {{ section.settings.padding_top }}px;
    --countdown-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="countdown-section__inner">
    {% if section.settings.heading != blank %}
      <h2 class="countdown-section__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div
      class="countdown-section__timer"
      id="countdown-root-{{ section.id }}"
      data-countdown-end="{{ end_raw | escape }}"
    >
      <div class="countdown-section__unit hidden" data-cd-days-wrap>
        <span class="countdown-section__value" data-cd-days>00</span>
        <span class="countdown-section__label">Días</span>
      </div>
      <div class="countdown-section__unit">
        <span class="countdown-section__value" data-cd-hours>00</span>
        <span class="countdown-section__label">Horas</span>
      </div>
      <div class="countdown-section__unit">
        <span class="countdown-section__value" data-cd-minutes>00</span>
        <span class="countdown-section__label">Min</span>
      </div>
      <div class="countdown-section__unit">
        <span class="countdown-section__value" data-cd-seconds>00</span>
        <span class="countdown-section__label">Seg</span>
      </div>
    </div>

    {% if section.settings.subtext != blank %}
      <p class="countdown-section__sub">
        {{ section.settings.subtext | escape }}
      </p>
    {% endif %}
  </div>
</div>

{% style %}
  .countdown-section {
    background-color: #8c505a;
    color: #ffffff;
    padding-top: var(--countdown-pad-top, 32px);
    padding-bottom: var(--countdown-pad-bottom, 32px);
  }
  .countdown-section__inner {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
    box-sizing: border-box;
  }
  .countdown-section__heading {
    text-align: center;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-weight: 500;
    margin: 0 0 1.25rem;
    color: #ffffff;
  }
  @media (min-width: 768px) {
    .countdown-section__heading {
      margin-bottom: 1.5rem;
    }
  }
  .countdown-section__timer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.65rem;
  }
  @media (min-width: 768px) {
    .countdown-section__timer {
      gap: 0.35rem 0.85rem;
    }
  }
  .countdown-section__heading,
  .countdown-section__sub {
    color: #ffffff;
  }
  .countdown-section__sub {
    text-align: center;
    font-size: 0.8125rem;
    opacity: 0.9;
    margin: 1.5rem auto 0;
    max-width: 42rem;
  }
  @media (min-width: 768px) {
    .countdown-section__sub {
      margin-top: 1.5rem;
    }
  }
  .countdown-section__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 3.25rem;
  }
  .countdown-section__value {
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    font-weight: 600;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    color: #ffffff;
  }
  .countdown-section__label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.85;
    color: #ffffff;
  }
  .countdown-section__unit.hidden {
    display: none !important;
  }
{% endstyle %}

<script>
  (function () {
    function pad(n) {
      return n < 10 ? '0' + String(n) : String(n);
    }

    function initCountdown() {
      var root = document.getElementById('countdown-root-{{ section.id }}');
      if (!root) return;

      var endStr = root.getAttribute('data-countdown-end');
      if (!endStr) return;

      var wrapDays = root.querySelector('[data-cd-days-wrap]');
      var elDays = root.querySelector('[data-cd-days]');
      var elHours = root.querySelector('[data-cd-hours]');
      var elMinutes = root.querySelector('[data-cd-minutes]');
      var elSeconds = root.querySelector('[data-cd-seconds]');

      function tick() {
        var target = new Date(endStr).getTime();
        var now = Date.now();
        var duration = target - now;

        if (duration <= 0) {
          if (elDays) elDays.textContent = '00';
          if (elHours) elHours.textContent = '00';
          if (elMinutes) elMinutes.textContent = '00';
          if (elSeconds) elSeconds.textContent = '00';
          if (wrapDays) wrapDays.classList.add('hidden');
          return;
        }

        var days = Math.floor(duration / (1000 * 60 * 60 * 24));
        var hours = Math.floor((duration % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        var minutes = Math.floor((duration % (1000 * 60 * 60)) / (1000 * 60));
        var seconds = Math.floor((duration % (1000 * 60)) / 1000);

        if (wrapDays) {
          if (days > 0) {
            wrapDays.classList.remove('hidden');
            if (elDays) elDays.textContent = pad(days);
          } else {
            wrapDays.classList.add('hidden');
          }
        }
        if (elHours) elHours.textContent = pad(hours);
        if (elMinutes) elMinutes.textContent = pad(minutes);
        if (elSeconds) elSeconds.textContent = pad(seconds);
      }

      tick();
      setInterval(tick, 1000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCountdown);
    } else {
      initCountdown();
    }
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Countdown",
  "tag": "section",
  "class": "section-countdown",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Oferta por tiempo limitado"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Texto inferior",
      "info": "Opcional. Déjalo vacío para ocultar."
    },
    {
      "type": "text",
      "id": "start_datetime",
      "label": "Fecha y hora de inicio",
      "info": "Opcional si solo usas fin. Con inicio + fin, la sección solo se muestra entre ambas fechas (hora de la tienda). Ej: 2026-03-01 00:00:00"
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "Fecha y hora de fin",
      "info": "Obligatorio. Ej: 2026-12-31 23:59:59 o solo 2026-12-31 (se usa 23:59:59). Si no pones inicio, se muestra hasta esta fecha."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Countdown"
    }
  ]
}
{% endschema %}
