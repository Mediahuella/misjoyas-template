{%- if section.settings.enable -%}
{%- style -%}
  .misjoyas-topbar-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .misjoyas-topbar-track-{{ section.id }} {
    display: flex;
    gap: {{ section.settings.gap }}px;
    padding: {{ section.settings.padding_vertical }}px 0;
    font-size: {{ section.settings.font_size }}px;
    font-weight: 500;
    letter-spacing: .4px;
    animation: misjoyasScroll-{{ section.id }} {{ section.settings.animation_speed }}s linear infinite;
  }
  .misjoyas-topbar-track-{{ section.id }} span {
    display: inline-block;
  }
  @keyframes misjoyasScroll-{{ section.id }} {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (max-width: 600px) {
    .misjoyas-topbar-track-{{ section.id }} {
      font-size: {{ section.settings.font_size | minus: 2 }}px;
      gap: {{ section.settings.gap | times: 0.67 | round }}px;
      padding: {{ section.settings.padding_vertical | minus: 2 }}px 0;
    }
  }
{%- endstyle -%}

<div class="misjoyas-topbar-{{ section.id }}">
  <div class="misjoyas-topbar-track-{{ section.id }}">
    {%- for i in (1..6) -%}
      <span>{{ section.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "MisJoyas Topbar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Mostrar barra",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Mensaje",
      "default": "🎁 Todas las Compras desde $49.990 durante MAYO participan en el sorteo de 20 Giftcards de $50.000 🎁"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Velocidad (segundos por ciclo)",
      "min": 5,
      "max": 60,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tamaño de fuente (px)",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Separación entre repeticiones (px)",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Padding vertical (px)",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "MisJoyas Topbar"
    }
  ]
}
{% endschema %}
