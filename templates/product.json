      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "<div class=\"misjoyas-comparison\">\n\n<h2 class=\"misjoyas-title\">¿Por qué elegirnos?</h2>\n\n<table class=\"misjoyas-table\">\n\n<thead>\n<tr>\n<th></th>\n<th>Otras marcas</th>\n<th class=\"misjoyas-us\">Nosotros</th>\n</tr>\n</thead>\n\n<tbody>\n\n<tr>\n<td>Calidad del material</td>\n<td>Plata de baja calidad o baños</td>\n<td class=\"misjoyas-us\">Plata fina certificada Ley 925</td>\n</tr>\n\n<tr>\n<td>Precios</td>\n<td>Precios elevados</td>\n<td class=\"misjoyas-us\">Precios competitivos y descuentos por volumen</td>\n</tr>\n\n<tr>\n<td>Variedad de diseños</td>\n<td>Colecciones limitadas</td>\n<td class=\"misjoyas-us\">Amplia variedad de modelos modernos</td>\n</tr>\n\n<tr>\n<td>Confianza</td>\n<td>Poca información del material</td>\n<td class=\"misjoyas-us\">Transparencia y calidad garantizada</td>\n</tr>\n\n<tr>\n<td>Oportunidad de negocio</td>\n<td>No pensado para emprendedores</td>\n<td class=\"misjoyas-us\">Ideal para revender y emprender</td>\n</tr>\n\n</tbody>\n\n</table>\n\n</div>\n\n<style>\n\n.misjoyas-comparison{\nmargin:50px 0;\ntext-align:center;\nfont-family:inherit;\n}\n\n.misjoyas-title{\nfont-size:28px;\nmargin-bottom:25px;\n}\n\n.misjoyas-table{\nwidth:100%;\nmax-width:900px;\nmargin:auto;\nborder-collapse:collapse;\nfont-size:14px;\n}\n\n.misjoyas-table th,\n.misjoyas-table td{\npadding:14px;\nborder-bottom:1px solid #eee;\n}\n\n.misjoyas-table th{\nbackground:#f8f8f8;\nfont-weight:600;\n}\n\n.misjoyas-us{\nbackground:#f3f7f5;\nfont-weight:600;\ncolor:#0b6b4f;\n}\n\n.misjoyas-table tr:hover{\nbackground:#fafafa;\n}\n\n/* responsive */\n\n@media (max-width:768px){\n\n.misjoyas-table{\nfont-size:12px;\n}\n\n.misjoyas-table th,\n.misjoyas-table td{\npadding:10px;\n}\n\n}\n\n</style>",
        "full_width": false,
