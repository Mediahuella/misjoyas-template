    "custom_liquid_NLGn9E": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign metal_mf = product.metafields.custom.tipo_de_metal\n  assign metal_str = ''\n  if metal_mf != blank\n    assign metal_str = metal_mf | metafield_text | strip\n    if metal_str == blank\n      if metal_mf.type contains 'list.'\n        assign metal_str = metal_mf.value | first | append: '' | strip\n      elsif metal_mf.value.system != blank\n        assign metal_str = metal_mf.value.label | default: metal_mf.value.name | default: metal_mf.value.value | append: '' | strip\n      else\n        assign metal_str = metal_mf.value | default: metal_mf | append: '' | strip\n      endif\n    endif\n  endif\n\n  assign show_desc = false\n  assign is_plata = false\n  assign is_revestimiento = false\n  if metal_str == 'Plata 925'\n    assign show_desc = true\n    assign is_plata = true\n  elsif metal_str == 'Recubrimiento Baño de Oro 18 k'\n    assign show_desc = true\n    assign is_revestimiento = true\n  endif\n-%}\n{%- liquid\n  assign clean_description = product.description | replace: '</p>', '</p><!--MJBR-->' | replace: '<br>', '<!--MJBR-->' | replace: '<br/>', '<!--MJBR-->' | replace: '<br />', '<!--MJBR-->' | strip_html | replace: '<!--MJBR-->', '<br>' | replace: 'Grosor:', '<br>Grosor:' | replace: 'Ancho:', '<br>Ancho:' | strip\n-%}\n{%- if show_desc -%}\n{%- if clean_description != blank or is_revestimiento -%}\n<div class=\"misjoyas-details\">\n\n  {%- if clean_description != blank -%}\n  <div class=\"misjoyas-details__item\" data-open=\"true\">\n    <button type=\"button\" class=\"misjoyas-details__header\" aria-expanded=\"true\">\n      <span class=\"misjoyas-details__title\">Detalles adicionales</span>\n      <span class=\"misjoyas-details__toggle\" aria-hidden=\"true\">−</span>\n    </button>\n    <div class=\"misjoyas-details__panel\">\n      <div class=\"misjoyas-details__body\">{{ clean_description }}</div>\n    </div>\n  </div>\n  {%- endif -%}\n\n  {%- if is_revestimiento -%}\n  <div class=\"misjoyas-details__item\" data-open=\"true\">\n    <button type=\"button\" class=\"misjoyas-details__header\" aria-expanded=\"true\">\n      <span class=\"misjoyas-details__title\">Protección y terminación</span>\n      <span class=\"misjoyas-details__toggle\" aria-hidden=\"true\">−</span>\n    </button>\n    <div class=\"misjoyas-details__panel\">\n      <div class=\"misjoyas-details__body\">\n        Barniz protector italiano que ayuda a conservar el brillo y la apariencia de la pieza en el tiempo.<br>\n        Terminación de pulido premium bajo el estándar de calidad MISJOYAS.\n      </div>\n    </div>\n  </div>\n\n  <div class=\"misjoyas-details__item\" data-open=\"true\">\n    <button type=\"button\" class=\"misjoyas-details__header\" aria-expanded=\"true\">\n      <span class=\"misjoyas-details__title\">Cuidados</span>\n      <span class=\"misjoyas-details__toggle\" aria-hidden=\"true\">−</span>\n    </button>\n    <div class=\"misjoyas-details__panel\">\n      <div class=\"misjoyas-details__body\">\n        Evitar agua, perfumes, cremas, productos químicos y humedad. Guardar por separado (en su estuche) y limpiar con un paño seco.<br>\n        Ponte la joya al final, después de cremas y perfume.\n      </div>\n    </div>\n  </div>\n  {%- endif -%}\n\n</div>\n{%- endif -%}\n\n{%- if is_plata or is_revestimiento -%}\n<div class=\"misjoyas-estandar\">\n  <picture>\n    {%- if is_revestimiento -%}\n      <source media=\"(max-width: 767px)\" srcset=\"{{ 'estandar-Oro-MJ_mobile.jpg' | asset_url }}\" width=\"800\" height=\"1664\">\n      <img\n        class=\"misjoyas-estandar__img\"\n        src=\"{{ 'estandar-Oro-MJ_desktop.jpg' | asset_url }}\"\n        alt=\"Estándar MISJOYAS — Calidad certificada Baño de Oro 18K\"\n        width=\"2560\"\n        height=\"560\"\n        loading=\"lazy\"\n        decoding=\"async\"\n      >\n    {%- else -%}\n      <source media=\"(max-width: 767px)\" srcset=\"{{ 'estandar-Plata-MJ_mobile.jpg' | asset_url }}\" width=\"800\" height=\"1664\">\n      <img\n        class=\"misjoyas-estandar__img\"\n        src=\"{{ 'estandar-Plata-MJ_desktop.jpg' | asset_url }}\"\n        alt=\"Estándar MISJOYAS — Calidad certificada Plata 925\"\n        width=\"2560\"\n        height=\"560\"\n        loading=\"lazy\"\n        decoding=\"async\"\n      >\n    {%- endif -%}\n  </picture>\n</div>\n{%- endif -%}\n\n<style>\n.misjoyas-details{\n  width:100%;\n  font-family:inherit;\n  color:#000;\n}\n.misjoyas-details__item{\n  border-top:1px solid #e0e0e0;\n  background:#fff;\n}\n.misjoyas-details__header{\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:8px;\n  width:100%;\n  padding:20px 0 0;\n  border:0;\n  background:transparent;\n  cursor:pointer;\n  text-align:left;\n  color:#000;\n  font-family:inherit;\n}\n.misjoyas-details__title{\n  flex:1;\n  min-width:0;\n  font-size:18px;\n  font-weight:700;\n  line-height:24px;\n}\n.misjoyas-details__toggle{\n  flex-shrink:0;\n  font-size:26px;\n  font-weight:400;\n  line-height:32px;\n  width:1em;\n  text-align:center;\n}\n.misjoyas-details__panel{\n  overflow:hidden;\n}\n.misjoyas-details__item[data-open=\"false\"] .misjoyas-details__panel{\n  display:none;\n}\n.misjoyas-details__body{\n  padding:8px 0 20px;\n  font-size:15px;\n  font-weight:400;\n  line-height:22px;\n  color:#000;\n}\n.misjoyas-estandar{\n  width:100%;\n  margin:20px 0 0;\n  padding:20px 0 0;\n}\n.misjoyas-estandar__img{\n  display:block;\n  width:100%;\n  height:auto;\n  border-radius:4px;\n}\n@media (max-width:767px){\n  .misjoyas-details__title{\n    font-size:16px;\n    line-height:22px;\n  }\n  .misjoyas-details__toggle{\n    font-size:22px;\n    line-height:28px;\n  }\n  .misjoyas-details__body{\n    font-size:14px;\n    line-height:20px;\n  }\n  .misjoyas-estandar{\n    margin-top:12px;\n    padding-top:12px;\n  }\n}\n</style>\n\n<script>\n(function () {\n  document.querySelectorAll('.misjoyas-details').forEach(function (root) {\n    if (root.dataset.bound) return;\n    root.dataset.bound = '1';\n    root.querySelectorAll('.misjoyas-details__header').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var item = btn.closest('.misjoyas-details__item');\n        var open = item.getAttribute('data-open') !== 'false';\n        item.setAttribute('data-open', open ? 'false' : 'true');\n        btn.setAttribute('aria-expanded', open ? 'false' : 'true');\n        btn.querySelector('.misjoyas-details__toggle').textContent = open ? '+' : '−';\n      });\n    });\n  });\n})();\n</script>\n{%- endif -%}",
