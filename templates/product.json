          "settings": {
            "custom_html": "<div class=\"misjoyas-wholesale\" data-open=\"true\">\n  <button type=\"button\" class=\"misjoyas-wholesale__header\" aria-expanded=\"true\">\n    <span class=\"misjoyas-wholesale__icon\" aria-hidden=\"true\">\n      <img src=\"{{ 'misjoyas-icon-wholesale-bag.svg' | asset_url }}\" alt=\"\" width=\"18\" height=\"18\" loading=\"lazy\">\n    </span>\n    <strong class=\"misjoyas-wholesale__title\">Descuentos exclusivos mayoristas</strong>\n    <span class=\"misjoyas-wholesale__toggle\" aria-hidden=\"true\">−</span>\n  </button>\n\n  <div class=\"misjoyas-wholesale__panel\">\n    <div class=\"misjoyas-wholesale__body\">\n      <p><strong>✓ Tramos de descuentos automáticos:</strong></p>\n      <p>• 10% OFF sobre $150.000<br>\n         • 15% OFF sobre $400.000<br>\n         • 20% OFF sobre $1.000.000</p>\n      <p class=\"misjoyas-wholesale__note\">Los descuentos se aplican automáticamente en el carrito al alcanzar el monto.</p>\n    </div>\n  </div>\n</div>\n\n<style>\n.misjoyas-wholesale {\n  width: 100%;\n  margin-bottom: 20px;\n}\n.misjoyas-wholesale__header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 10px 16px;\n  background: rgba(248, 55, 133, 0.12);\n  border: 0;\n  border-radius: 4px 4px 0 0;\n  cursor: pointer;\n  text-align: left;\n  color: #000;\n  font-family: inherit;\n  font-weight: 700;\n}\n.misjoyas-wholesale[data-open=\"false\"] .misjoyas-wholesale__header {\n  border-radius: 4px;\n}\n.misjoyas-wholesale__icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: #f83785;\n}\n.misjoyas-wholesale__icon img {\n  display: block;\n  width: 18px;\n  height: 18px;\n}\n.misjoyas-wholesale__title {\n  flex: 1;\n  min-width: 0;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: normal;\n}\n.misjoyas-wholesale__toggle {\n  flex-shrink: 0;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1;\n  width: 1em;\n  text-align: center;\n}\n.misjoyas-wholesale__panel {\n  border: 1px solid #e0e0e0;\n  border-top: 0;\n  border-radius: 0 0 4px 4px;\n  background: #fff;\n}\n.misjoyas-wholesale[data-open=\"false\"] .misjoyas-wholesale__panel {\n  display: none;\n}\n.misjoyas-wholesale__body {\n  padding: 10px 16px;\n  font-size: 14px;\n  font-weight: 600;\n  line-height: normal;\n  color: #000;\n}\n.misjoyas-wholesale__body p {\n  margin: 0;\n}\n.misjoyas-wholesale__note {\n  color: #737373;\n  font-weight: 400;\n  line-height: 20px;\n}\n</style>\n\n<script>\n(function () {\n  document.querySelectorAll('.misjoyas-wholesale').forEach(function (el) {\n    if (el.dataset.bound) return;\n    el.dataset.bound = '1';\n    var btn = el.querySelector('.misjoyas-wholesale__header');\n    var toggle = el.querySelector('.misjoyas-wholesale__toggle');\n    btn.addEventListener('click', function () {\n      var open = el.getAttribute('data-open') !== 'false';\n      el.setAttribute('data-open', open ? 'false' : 'true');\n      btn.setAttribute('aria-expanded', open ? 'false' : 'true');\n      toggle.textContent = open ? '+' : '−';\n    });\n  });\n})();\n</script>"
