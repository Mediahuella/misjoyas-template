        "html_prodDesc": {
          "type": "html",
          "settings": {
            "custom_html": "{%- liquid\n  assign metal_mf = product.metafields.custom.tipo_de_metal\n  assign metal_str = ''\n  if metal_mf != blank\n    assign metal_str = metal_mf | metafield_text | strip\n    if metal_str == blank\n      if metal_mf.type contains 'list.'\n        assign metal_str = metal_mf.value | first | append: '' | strip\n      elsif metal_mf.value.system != blank\n        assign metal_str = metal_mf.value.label | default: metal_mf.value.name | default: metal_mf.value.value | append: '' | strip\n      else\n        assign metal_str = metal_mf.value | default: metal_mf | append: '' | strip\n      endif\n    endif\n  endif\n\n  assign show_desc = false\n  assign is_plata = false\n  assign is_revestimiento = false\n  if metal_str == 'Plata 925'\n    assign show_desc = true\n    assign is_plata = true\n  elsif metal_str == 'Recubrimiento Baño de Oro 18 k'\n    assign show_desc = true\n    assign is_revestimiento = true\n  endif\n-%}\n{%- if show_desc and product.description != blank -%}\n{%- liquid\n  assign short_desc = product.description | strip_html | strip | split: '. ' | first | strip\n  if short_desc != blank\n    assign short_end = short_desc | slice: -1, 1\n    if short_end != '.'\n      assign short_desc = short_desc | append: '.'\n    endif\n  endif\n-%}\n<div class=\"misjoyas-product-desc\">{{ short_desc }}</div>\n<style>\n.misjoyas-product-desc{\n  width:100%;\n  margin:0 0 16px;\n  color:#000;\n  font-size:15px;\n  font-weight:400;\n  line-height:22px;\n}\n@media (max-width:767px){\n  .misjoyas-product-desc{\n    font-size:14px;\n    line-height:20px;\n    margin-bottom:12px;\n  }\n}\n</style>\n{%- endif -%}"
          }
