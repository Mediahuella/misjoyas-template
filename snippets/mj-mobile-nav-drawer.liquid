{% comment %}
  MisJoyas mobile nav drawer.
  Renders from header.liquid so items use the same button / tree_menu blocks as desktop.
  Optional UI chrome (logo, footer) from sections['mobile-navigation'] when present.

  Accepts: nav_section (header section)
{% endcomment %}
{%- liquid
  assign ui = sections['mobile-navigation']
  assign nav_logo = nav_section.settings.logo
  if ui != blank and ui.settings.logo != blank
    assign nav_logo = ui.settings.logo
  endif

  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
  else
    assign is_rtl = false
  endif

  assign menus = blank
  if nav_section.settings.enable_highlight
    assign menus = nav_section.settings.menus | newline_to_br | strip_newlines | split: '<br />'
  endif

  assign show_stores = true
  assign show_footer_links = true
  assign show_footer_login = true
  assign show_footer_social = true
  assign stores_text = 'sections.mobile-navigation.stores_footer' | t
  if stores_text == blank or stores_text contains 'Translation missing'
    assign stores_text = 'Tiendas — 37 en todo Chile'
  endif
  assign stores_href = pages['tiendas'].url | default: '/pages/tiendas'
  assign footer_link_1_text = 'Plata 925 certificada'
  assign footer_link_1_url = collections['plata-925'].url | default: '/collections/plata-925'
  assign footer_link_1_show_check = true
  assign footer_link_2_text = 'Todo para emprender'
  assign footer_link_2_url = pages['todo-para-emprender'].url | default: '/pages/todo-para-emprender'
  assign show_language = false

  if ui != blank
    assign show_stores = ui.settings.show_stores_footer
    assign show_footer_links = ui.settings.show_footer_links
    assign show_footer_login = ui.settings.show_footer_login
    assign show_footer_social = ui.settings.show_footer_social
    if ui.settings.stores_footer_text != blank
      assign stores_text = ui.settings.stores_footer_text
    endif
    if ui.settings.stores_footer_link != blank
      assign stores_href = ui.settings.stores_footer_link
    endif
    if ui.settings.footer_link_1_text != blank
      assign footer_link_1_text = ui.settings.footer_link_1_text
    endif
    if ui.settings.footer_link_1_link != blank
      assign footer_link_1_url = ui.settings.footer_link_1_link
    endif
    assign footer_link_1_show_check = ui.settings.footer_link_1_show_check
    if ui.settings.footer_link_2_text != blank
      assign footer_link_2_text = ui.settings.footer_link_2_text
    endif
    if ui.settings.footer_link_2_link != blank
      assign footer_link_2_url = ui.settings.footer_link_2_link
    endif
    if ui.settings.show_currency_selector or ui.settings.show_language_selector
      assign show_language = true
    endif
  endif
-%}
{%- style -%}
  #MobileNavDrawer .text-color,
  #MobileNavDrawer .background-header {
    {%- if ui != blank and ui.settings.background_color.alpha != 0.0 -%}
      background: {{ ui.settings.background_color }};
    {%- endif -%}
    {%- if ui != blank and ui.settings.text_color.alpha != 0.0 -%}
      --colors-heading: {{ ui.settings.text_color.red }}, {{ ui.settings.text_color.green }}, {{ ui.settings.text_color.blue }};
      color: {{ ui.settings.text_color }};
      --colors-text-header: {{ ui.settings.text_color.red }}, {{ ui.settings.text_color.green }}, {{ ui.settings.text_color.blue }};
    {%- endif -%}
  }
{%- endstyle -%}
<div
  class="z-[60] fixed top-0 h-full w-full opacity-60 bg-black"
  x-show="$store.xMobileNav.show"
  x-cloak
  @click="$store.xMobileNav.close()"
></div>
<div
  id="MobileNavDrawer"
  :class="{ 'menu-opening': $store.xMobileNav.show }"
  class="mj-mobile-nav menu-drawer fixed z-[60] top-0 bottom-0 w-full max-w-none motion-reduce invisible overflow-x-hidden{% if is_rtl %} rtl right-0 translate-x-full{% else %} ltr left-0 -translate-x-full{% endif %}"
  x-cloak
>
  <div class="x-container-mobile-nav background-header gradient menu-drawer duration-300 ease-in-out overflow-hidden h-full flex flex-col">
    <div class="mj-mobile-nav__header">
      <a href="{{ routes.root_url }}" class="mj-mobile-nav__logo disable-effect" aria-label="{{ shop.name | escape }}">
        {%- if nav_logo != blank -%}
          {{
            nav_logo
            | image_url: width: 120
            | image_tag:
              widths: '60, 80, 120',
              loading: 'lazy',
              alt: shop.name,
              class: 'mj-mobile-nav__logo-img'
          }}
        {%- else -%}
          <span class="mj-mobile-nav__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <button
        type="button"
        class="mj-mobile-nav__close"
        aria-label="{{ 'accessibility.close' | t }}"
        @click="$store.xMobileNav.close()"
      >
        {% render 'icon-alls', icon: 'icon-close' %}
      </button>
    </div>
    <div
      id="menu-navigation"
      class="h-full flex-1 overflow-x-hidden scrollbar-body"
      :class="$store.xMobileNav.currentMenuLinks.length == 0 ? ' overflow-y-auto' : 'overflow-hidden'"
    >
      <ul
        id="menu-level-0"
        role="list"
        class="menu-parent relative h-full w-full mj-mobile-nav__list"
      >
        <li class="block-mobile-navigation x-header-store-selector-container pl-5 pr-5 pb-5"></li>
        {%- for block in nav_section.blocks -%}
          {%- if block.type == 'button' or block.type == 'tree_menu' -%}
            {%- assign index = 'h' | append: forloop.index -%}
            {% render 'mj-mobile-menu-item',
              block: block,
              section: nav_section,
              index: index,
              menus: menus,
              is_rtl: is_rtl
            %}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    {%- if show_stores or show_footer_links or show_footer_login or show_footer_social -%}
      <div class="mj-mobile-nav__footer">
        {%- if show_stores -%}
          <a href="{{ stores_href }}" class="mj-mobile-nav__stores disable-effect">
            <span class="mj-mobile-nav__stores-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <path d="M3 9.5L4.5 4h15L21 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 9.5V20h16V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9.5 20v-6h5v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 9.5h3.2a2.3 2.3 0 0 0 4.6 0h.4a2.3 2.3 0 0 0 4.6 0H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="mj-mobile-nav__stores-text">
              {%- assign stores_parts = stores_text | split: '—' -%}
              {%- if stores_parts.size > 1 -%}
                <strong>{{ stores_parts.first | strip | escape }} — </strong>{{ stores_parts.last | strip | escape }}
              {%- else -%}
                {{ stores_text | escape }}
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}

        <div class="mj-mobile-nav__footer-body">
          {%- if show_footer_links or show_footer_login -%}
            <div class="mj-mobile-nav__footer-links">
              {%- if show_footer_links and footer_link_1_text != blank -%}
                <a href="{{ footer_link_1_url | default: '#' }}" class="mj-mobile-nav__footer-link disable-effect">
                  {%- if footer_link_1_show_check -%}
                    <span class="mj-mobile-nav__footer-check" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="8" cy="8" r="7.25" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M4.75 8.25L7 10.5L11.25 5.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  {%- endif -%}
                  <span class="mj-mobile-nav__footer-link-text">{{ footer_link_1_text | escape }}</span>
                  <span class="mj-mobile-nav__footer-chevron" aria-hidden="true"></span>
                </a>
              {%- endif -%}

              {%- if show_footer_links and footer_link_2_text != blank -%}
                <a href="{{ footer_link_2_url | default: '#' }}" class="mj-mobile-nav__footer-link disable-effect">
                  <span class="mj-mobile-nav__footer-link-text">{{ footer_link_2_text | escape }}</span>
                  <span class="mj-mobile-nav__footer-chevron" aria-hidden="true"></span>
                </a>
              {%- endif -%}

              {%- if show_footer_login and shop.customer_accounts_enabled -%}
                <a
                  href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                  class="mj-mobile-nav__footer-link mj-mobile-nav__footer-link--account disable-effect"
                  data-no-instant
                >
                  <span class="mj-mobile-nav__footer-account-icon" aria-hidden="true">
                    {% render 'icon-alls', icon: 'icon-account' %}
                  </span>
                  <span class="mj-mobile-nav__footer-link-text">
                    {%- if customer -%}
                      {{ 'customer.account_fallback' | t }}
                    {%- else -%}
                      {{ 'customer.log_in' | t }}
                    {%- endif -%}
                  </span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if show_footer_social -%}
            <div class="mj-mobile-nav__footer-social">
              {% render 'social-icons', footer: true %}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if show_language and ui != blank -%}
      <div class="x-container-mobile-nav-language pt-1.5 pb-1.5 pl-5 pr-5 lg:flex lg:items-center z-50 background-header justify-center lg:justify-end bottom-0 left-0 max-w-sm border-t">
        {%- render 'toolbar',
          mobile: true,
          show_currency_selector: ui.settings.show_currency_selector,
          show_language_selector: ui.settings.show_language_selector
        -%}
      </div>
    {%- endif -%}
  </div>
</div>
