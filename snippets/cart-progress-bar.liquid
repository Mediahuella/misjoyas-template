{% comment %}
  Renders cart progress bar with 4 tiers (left to right): Envío gratis, 10% OFF, 15% OFF, 20% OFF
{% endcomment %}
{%- if settings.enable_cart_progress_bar and cart.item_count > 0 -%}
  {%- liquid
    assign cart_total = cart.total_price | divided_by: 100.00

    assign threshold_shipping = nil
    assign freeshipping_thresholds = settings.order_amount_freeshipping | newline_to_br | strip_newlines | split: '<br />'
    if settings.order_amount_freeshipping contains ';'
      assign freeshipping_thresholds = settings.order_amount_freeshipping | remove: ' ' | split: ';'
    endif
    for threshold in freeshipping_thresholds
      unless threshold contains ':'
        if threshold != blank
          assign check_currency = threshold | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: ':' | remove: ' '
          if check_currency == '' or check_currency == '.'
            assign threshold_shipping = threshold | strip | plus: 0
          endif
        endif
      else
        assign check_currency_first = threshold | split: ':' | first
        assign check_currency_last = threshold | split: ':' | last
        assign check_currency = threshold | remove_first: check_currency_first | remove: check_currency_last
        if check_currency == ':'
          if check_currency_first == cart.currency.iso_code
            assign threshold_shipping = check_currency_last | strip | plus: 0
          endif
        else
          assign check_currency_country = check_currency | remove: ':'
          if check_currency_first == localization.country.iso_code and check_currency_country == cart.currency.iso_code
            assign threshold_shipping = check_currency_last | strip | plus: 0
          endif
        endif
      endunless
    endfor

    assign threshold_10 = settings.cart_progress_tier_2 | default: '150000' | plus: 0
    assign threshold_15 = settings.cart_progress_tier_3 | default: '400000' | plus: 0
    assign threshold_20 = settings.cart_progress_tier_4 | default: '1000000' | plus: 0

    if threshold_shipping == nil or threshold_shipping == 0
      assign threshold_shipping = 90000
    endif

    assign current_tier = 0
    assign next_tier_label = 'general.cart.progress_tier_1' | t
    assign progress_percent = 0
    assign amount_needed = 0

    if cart_total >= threshold_20
      assign current_tier = 4
      assign progress_percent = 100
    elsif cart_total >= threshold_15
      assign current_tier = 3
      assign next_tier_label = 'general.cart.progress_tier_4' | t
      assign segment_size = threshold_20 | minus: threshold_15
      assign progress_in_segment = cart_total | minus: threshold_15
      if segment_size > 0
        assign segment_percent = progress_in_segment | times: 25.0 | divided_by: segment_size
      else
        assign segment_percent = 25
      endif
      assign progress_percent = 75 | plus: segment_percent
      assign amount_needed = threshold_20 | minus: cart_total
    elsif cart_total >= threshold_10
      assign current_tier = 2
      assign next_tier_label = 'general.cart.progress_tier_3' | t
      assign segment_size = threshold_15 | minus: threshold_10
      assign progress_in_segment = cart_total | minus: threshold_10
      if segment_size > 0
        assign segment_percent = progress_in_segment | times: 25.0 | divided_by: segment_size
      else
        assign segment_percent = 25
      endif
      assign progress_percent = 50 | plus: segment_percent
      assign amount_needed = threshold_15 | minus: cart_total
    elsif cart_total >= threshold_shipping
      assign current_tier = 1
      assign next_tier_label = 'general.cart.progress_tier_2' | t
      assign segment_size = threshold_10 | minus: threshold_shipping
      assign progress_in_segment = cart_total | minus: threshold_shipping
      if segment_size > 0
        assign segment_percent = progress_in_segment | times: 25.0 | divided_by: segment_size
      else
        assign segment_percent = 25
      endif
      assign progress_percent = 25 | plus: segment_percent
      assign amount_needed = threshold_10 | minus: cart_total
    else
      assign next_tier_label = 'general.cart.progress_tier_1' | t
      if threshold_shipping > 0
        assign progress_percent = cart_total | times: 25.0 | divided_by: threshold_shipping
      endif
      assign amount_needed = threshold_shipping | minus: cart_total
    endif

    if progress_percent > 100
      assign progress_percent = 100
    endif

    assign amount_needed_formatted = amount_needed | times: 100 | money
  -%}
  <div class="cart-progress-bar misjoyas-cart-progress" x-data="{ active: false }" x-intersect:enter="active = true" x-intersect:leave="active = false">
    {% if current_tier < 4 %}
      <p class="misjoyas-cart-progress__message">
        {{ 'general.cart.progress_message_html' | t: amount: amount_needed_formatted, benefit: next_tier_label }}
      </p>
    {% else %}
      <p class="misjoyas-cart-progress__message">
        {{ 'general.cart.progress_max' | t }}
      </p>
    {% endif %}
    <div class="misjoyas-cart-progress__track-wrap">
      <div class="misjoyas-cart-progress__track">
        <div class="misjoyas-cart-progress__fill" style="width: {{ progress_percent }}%;"></div>
        <div class="misjoyas-cart-progress__dot{% if current_tier >= 1 %} is-reached{% endif %}" style="left: 0;"></div>
        <div class="misjoyas-cart-progress__dot{% if current_tier >= 2 %} is-reached{% endif %}" style="left: 33.33%;"></div>
        <div class="misjoyas-cart-progress__dot{% if current_tier >= 3 %} is-reached{% endif %}" style="left: 66.66%;"></div>
        <div class="misjoyas-cart-progress__dot{% if current_tier >= 4 %} is-reached{% endif %}" style="left: 100%;"></div>
      </div>
      <div class="misjoyas-cart-progress__labels">
        <span class="misjoyas-cart-progress__label-first">{{ 'general.cart.progress_tier_1' | t }}</span>
        <span>{{ 'general.cart.progress_tier_2' | t }}</span>
        <span>{{ 'general.cart.progress_tier_3' | t }}</span>
        <span>{{ 'general.cart.progress_tier_4' | t }}</span>
      </div>
    </div>
  </div>
{%- endif -%}
