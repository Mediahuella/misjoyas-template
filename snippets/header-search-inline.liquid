{%- liquid
  assign search_type = 'query,' | append: settings.search_type
-%}
<div
  class="mj-header-search hidden lg:flex tw-items-center tw-relative tw-w-full lg:tw-w-[468px]"
  x-data="xInlineSearch('{{ search_type }}', {{ settings.search_desktop_maximun_results | default: 6 }})"
  @click.away="closeResults()"
  @keyup.escape="closeResults()"
>
  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="mj-header-search__form tw-flex tw-items-center tw-h-[50px] tw-w-full lg:tw-w-[468px] tw-bg-white tw-border-[0.5px] tw-border-black tw-rounded-[4px] tw-pl-3 tw-pr-1 tw-gap-1.5"
  >
    <input type="hidden" name="options[prefix]" value="last">
    <input
      type="search"
      name="q"
      x-model="query"
      @input="keyUp()"
      @focus="focusForm()"
      class="tw-flex-1 tw-min-w-0 tw-bg-transparent tw-outline-none tw-text-base tw-leading-[22px] tw-text-[#2d2d2d] placeholder:tw-text-[#737373] placeholder:tw-opacity-70 [appearance:none] [-webkit-appearance:none]"
      placeholder="{{ 'general.search.placeholder' | t }}"
      autocomplete="off"
      aria-label="{{ 'general.search.search' | t }}"
    >
    <button
      type="submit"
      class="mj-header-search__btn tw-shrink-0 tw-flex tw-items-center tw-justify-center tw-w-[45px] tw-h-10 tw-text-black hover:tw-opacity-70 tw-transition-opacity"
      aria-label="{{ 'general.search.search' | t }}"
    >
      {%- render 'icon-alls', icon: 'icon-search' -%}
    </button>
  </form>

  {%- if settings.predictive_search_enabled -%}
    <div
      x-show="openResults"
      x-cloak
      x-html="result"
      class="tw-absolute tw-top-full tw-mt-1.5 tw-left-0 lg:tw-w-[468px] tw-z-50 tw-bg-white tw-shadow-md tw-rounded-[4px] tw-border tw-border-black/10 tw-max-h-96 tw-overflow-y-auto text-[rgb(var(--colors-text))]"
    ></div>
  {%- endif -%}
</div>
