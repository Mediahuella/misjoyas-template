{% comment %}
  Badges estáticos para tarjetas (sin xBadges JS).
  Replica las etiquetas principales del tema: nuevo, descuento, agotado, tag.
{% endcomment %}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign compare_at = variant.compare_at_price
  assign price = variant.price
  assign show_sale = false
  assign sale_pct = 0

  if compare_at > price
    assign show_sale = true
    assign sale_pct = compare_at | minus: price | times: 100.0 | divided_by: compare_at | round
    if sale_pct == 100
      assign sale_pct = 99
    endif
  endif

  assign show_new = false
  assign current_ts = 'now' | date: '%s'
  assign published_ts = product.published_at | date: '%s'
  assign diff_days = current_ts | minus: published_ts | times: 1.0 | divided_by: 86400 | round

  for col in product.collections
    if col.handle == 'nuevo' and diff_days <= 25
      assign show_new = true
      break
    endif
  endfor

  assign show_dia_madre = false
  if product.tags contains 'dia-madre'
    assign show_dia_madre = true
  endif
-%}

{%- if show_new -%}
  <div class="top-left-container label-container absolute gap-1 space-y-1 top-1 flex-col left-1 pointer-events-none z-20">
    <div class="x-badge-container pointer-events-none ltr w-max absolute text-start">
      <div
        class="x-badge-content ltr x-badge-text select-none inline-flex justify-center items-center pt-1 pb-1 pl-2 pr-2"
        style="font-size: 12px; background-color: #157f7f; color: #ffffff;"
      >
        <span class="leading-normal w-fit p-break-words">Nuevo</span>
      </div>
    </div>
  </div>
{%- endif -%}

{%- if show_dia_madre -%}
  <div class="top-left-container label-container absolute gap-1 space-y-1 top-1 flex-col right-1 left-auto pointer-events-none z-20">
    <div class="x-badge-container pointer-events-none ltr w-max absolute text-end" style="right: 0; left: auto;">
      <div
        class="x-badge-content ltr x-badge-text select-none inline-flex justify-center items-center pt-1 pb-1 pl-2 pr-2"
        style="font-size: 12px; background-color: #f83785; color: #ffffff;"
      >
        <span class="leading-normal w-fit p-break-words">Día de la Madre</span>
      </div>
    </div>
  </div>
{%- endif -%}

{%- unless product.available -%}
  <div class="top-left-container label-container absolute gap-1 space-y-1 top-1 flex-col left-1 pointer-events-none z-20">
    <div class="x-badge-container pointer-events-none ltr w-max absolute text-start">
      <div
        class="x-badge-content ltr x-badge-text select-none inline-flex justify-center items-center pt-2 pb-2 pl-3 pr-3"
        style="font-size: 14px; background-color: #444444; color: #ffffff;"
      >
        <span class="leading-normal w-fit p-break-words">{{ 'products.product.sold_out' | t }}</span>
      </div>
    </div>
  </div>
{%- else -%}
  {%- if show_sale -%}
    <div class="bottom-left-container label-container absolute gap-1 space-y-1 bottom-0 flex-col-reverse left-0 pointer-events-none z-20">
      <div class="x-badge-container pointer-events-none ltr w-max absolute text-start">
        <div
          class="x-badge-content ltr x-badge-text select-none inline-flex justify-center items-center pt-1 pb-1 pl-3 pr-3"
          style="background-color: #000000; color: #ffffff;"
        >
          <span class="leading-normal w-fit p-break-words">-{{ sale_pct }}%</span>
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endunless -%}
